get {
  url: {{BASE_URL}}/{{userPath}}/?role=admin,user&sort=created_at&order=desc&page=1&limit=10&gender=m,f
  body: none
  auth: inherit
}

params:query {
  role: admin,user
  sort: created_at
  order: desc
  page: 1
