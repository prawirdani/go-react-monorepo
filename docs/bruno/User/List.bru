example {
  name: Unauthenticated

  request: {
    url: {{BASE_URL}}/{{userPath}}/?role=admin,user&sort=created_at&order=desc&page=1&limit=10&gender=m,f
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "authentication required",
            "details": null,
            "code": "REQ_UNAUTHORIZED"
          }
        }
      '''
    }
  }
}

example {
  name: Forbidden

  request: {
    url: {{BASE_URL}}/{{userPath}}/?role=admin,user&sort=created_at&order=desc&page=1&limit=10&gender=m,f
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "unauthorized action",
            "details": null,
            "code": "RBAC_UNAUTHORIZED_PERM"
          }
        }
      '''
    }
  }
}
