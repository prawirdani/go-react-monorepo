meta {
  name: List User Session
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/{{authPath}}/sessions/users/{{userID}}
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

