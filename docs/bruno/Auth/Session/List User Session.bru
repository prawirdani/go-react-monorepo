example {
  name: Invalid Path Parameter

  request: {
    url: {{BASE_URL}}/{{authPath}}/sessions/users/not-a-uuid
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "invalid value 'not-a-uuid' for parameter 'userID'",
            "details": {
              "parameter": "userID",
              "value": "not-a-uuid"
            },
            "code": "INVALID_PARAMETER"
          }
        }
      '''
    }
  }
}

example {
  name: Unauthenticated

  request: {
    url: {{BASE_URL}}/{{authPath}}/sessions/users/{{userID}}
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "authentication required",
            "details": null,
            "code": "REQ_UNAUTHORIZED"
          }
        }
      '''
    }
  }
}

example {
  name: Forbidden

  request: {
    url: {{BASE_URL}}/{{authPath}}/sessions/users/{{userID}}
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "unauthorized action",
            "details": null,
            "code": "RBAC_UNAUTHORIZED_PERM"
          }
        }
      '''
    }
  }
}
