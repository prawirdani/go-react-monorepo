meta {
  name: Forgot Password
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/{{authPath}}/password/recover
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

example {
  name: Email Not Found / Not Registered
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover
    method: POST
    mode: json
    body:json: {
      {
        "email": "prawirdanix@gmail.com"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:40:05 GMT
      content-length: 123
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the requested resource was not found",
            "details": null,
            "code": "RESOURCE_NOT_FOUND"
          }
        }
      '''
    }
  }
}

example {
  name: Success
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover
    method: POST
    mode: json
    body:json: {
      {
        "email": "prawirdani@gmail.com"
      }
    }
  }
  
  response: {
    headers: {
      cache-control: private, must-revalidate
      content-type: application/json
      etag: "c4d95f8501a5dd6d414e02b4294b861c330e7ea8b0a420cb13d66f55ede6fe29"
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:42:25 GMT
      content-length: 87
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "message": "password recovery email has been sent"
        }
      '''
    }
  }
}

example {
  name: Validation Error

  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover
    method: POST
    mode: json
    body:json: {
      {
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the request contains invalid data",
            "details": {
              "email": [
                "this field is required"
              ]
            },
            "code": "VALIDATION"
          }
        }
      '''
    }
  }
}

example {
  name: Throttled (Retry-After header)

  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover
    method: POST
    mode: json
    body:json: {
      {
        "email": "prawirdani@gmail.com"
      }
    }
  }

  response: {
    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "too many password reset requests, please try again later",
            "details": null,
            "code": "AUTH_RECOVERY_THROTTLED"
          }
        }
      '''
    }
  }
}

example {
  name: Rate Limited

  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover
    method: POST
    mode: json
    body:json: {
      {
        "email": "prawirdani@gmail.com"
      }
    }
  }

  response: {
    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "too many request try again latter",
            "details": null,
            "code": "REQ_RATE_LIMIT"
          }
        }
      '''
    }
  }
}
