meta {
  name: Get Forgot Password Token
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/{{authPath}}/password/recover/{{recoveryToken}}
  body: none
  auth: none
}

example {
  name: Invalid Token / Not Found
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover/955f92597c3f51b5015f43e0afcc35dbb271cffe8a2b1b4e42aacc3a5fb97f01
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:38:32 GMT
      content-length: 123
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the requested resource was not found",
            "details": null,
            "code": "RESOURCE_NOT_FOUND"
          }
        }
      '''
    }
  }
}

example {
  name: Success
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/recover/86iU9x6MNfMlPcQw-8649QRssxRkL3oo5CRAia_GC7U
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      cache-control: private, must-revalidate
      content-type: application/json
      etag: "e5fb13962e0040f34ee573e6ea96b9fda4e5544dbd4e588603276ee2b098f990"
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 14:29:40 GMT
      content-length: 155
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": 3,
            "user_id": "019dba85-428c-7c0e-9969-bf03b2564234",
            "issued_at": "2026-04-23T14:23:03.317381Z",
            "expires_at": "2026-04-23T14:28:03.317381Z",
            "used_at": null
          },
          "message": null
        }
      '''
    }
  }
}
