meta {
  name: Change Password
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/{{authPath}}/password/change
  body: json
  auth: inherit
}

body:json {
  {
    "new_password": "123456789",
    "password": "{{password}}",
    "repeat_new_password": "123456789"
  }
}

example {
  name: Malformed JSON

  request: {
    url: {{BASE_URL}}/{{authPath}}/password/change
    method: PUT
    mode: json
    body:json: {
      {
        "password": "{{password}}",
        "new_password": "123456789",
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "Request body contains badly-formed JSON (at position 12)",
            "details": null,
            "code": "REQ_MALFORMED_JSON"
          }
        }
      '''
    }
  }
}

example {
  name: Invalid Current Password
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/change
    method: PUT
    mode: json
    body:json: {
      {
        "password": "87654321",
        "new_password": "12345678",
         "repeat_new_password": "12345678"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:35:40 GMT
      content-length: 110
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "check your credentials",
            "details": null,
            "code": "AUTH_CREDENTIALS"
          }
        }
      '''
    }
  }
}

example {
  name: Success
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/change
    method: PUT
    mode: json
    body:json: {
      {
        "password": "87654321",
        "new_password": "12345678",
         "repeat_new_password": "12345678"
      }
    }
  }
  
  response: {
    headers: {
      cache-control: private, must-revalidate
      content-type: application/json
      etag: "3910d7265c53e0a2d3e42fb9799bbff2c41b7c4c03c632044197f647fd760168"
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:36:10 GMT
      content-length: 90
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "message": "Password has been changed successfully!"
        }
      '''
    }
  }
}

example {
  name: Validation Errors
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/change
    method: PUT
    mode: json
    body:json: {
      {
          
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:36:36 GMT
      content-length: 144
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the request contains invalid data",
            "details": {
              "new_password": [
                "this field is required"
              ],
              "password": [
                "this field is required"
              ]
            },
            "code": "VALIDATION"
          }
        }
      '''
    }
  }
}

example {
  name: Forbidden

  request: {
    url: {{BASE_URL}}/{{authPath}}/password/change
    method: PUT
    mode: json
    body:json: {
      {
        "password": "12345678",
        "new_password": "12345678",
        "repeat_new_password": "12345678"
      }
    }
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "unauthorized action",
            "details": null,
            "code": "RBAC_UNAUTHORIZED_PERM"
          }
        }
      '''
    }
  }
}

example {
  name: User Not Found

  request: {
    url: {{BASE_URL}}/{{authPath}}/password/change
    method: PUT
    mode: json
    body:json: {
      {
        "password": "12345678",
        "new_password": "12345678",
        "repeat_new_password": "12345678"
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the requested resource was not found",
            "details": null,
            "code": "RESOURCE_NOT_FOUND"
          }
        }
      '''
    }
  }
}
