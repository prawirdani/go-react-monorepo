meta {
  name: Reset Password
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/{{authPath}}/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "{{recoveryToken}}",
    "new_password": "12345678",
    "repeat_new_password": "12345678"
  }
}

example {
  name: Invalid or Expired Token
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/reset
    method: PUT
    mode: json
    body:json: {
      {
        "token": "955f92597c3f51b5015f43e0afcc35dbb271cffe8a2b1b4e42aacc3a5fb97f01",
        "new_password": "12345678",
         "repeat_new_password": "12345678"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 14:29:56 GMT
      content-length: 135
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "invalid or expired password recovery token",
            "details": null,
            "code": "AUTH_INVALID_RECOV_TOKEN"
          }
        }
      '''
    }
  }
}

example {
  name: Success
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/reset
    method: PUT
    mode: json
    body:json: {
      {
        "token": "vmW1Oe_sGjTw4z3Vba31w2VrUO9fjDZ_l9LzORysBhU",
        "new_password": "12345678",
         "repeat_new_password": "12345678"
      }
    }
  }
  
  response: {
    headers: {
      cache-control: private, must-revalidate
      content-type: application/json
      etag: "d2bb6d172d875a73fa23bf2f6656d6b1398f968a2683579be2a2b93d8c5b7c4f"
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 14:46:12 GMT
      content-length: 88
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "message": "Password has been reset successfully!"
        }
      '''
    }
  }
}

example {
  name: Validation Errors
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/password/reset
    method: PUT
    mode: json
    body:json: {
      {
        
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 14:46:40 GMT
      content-length: 149
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the request contains invalid data",
            "details": {
              "new_password": [
                "this field is required"
              ],
              "token": [
                "this field is required"
              ]
            },
            "code": "VALIDATION"
          }
        }
      '''
    }
  }
}
