example {
  name: Unauthenticated
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/refresh
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:32:15 GMT
      content-length: 111
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "authentication required",
            "details": null,
            "code": "REQ_UNAUTHORIZED"
          }
        }
      '''
    }
  }
}

example {
  name: Invalid or Expired Token
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/refresh
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:33:32 GMT
      content-length: 125
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "session has been expired or revoked",
            "details": null,
            "code": "AUTH_INVALID_SESSION"
          }
        }
      '''
    }
  }
}

