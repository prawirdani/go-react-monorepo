example {
  name: Malformed JSON

  request: {
    url: {{BASE_URL}}/{{authPath}}/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "prawirdani@gmail.com",
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "Request body contains badly-formed JSON (at position 12)",
            "details": null,
            "code": "REQ_MALFORMED_JSON"
          }
        }
      '''
    }
  }
}

example {
  name: Invalid Creds
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/login
    method: POST
    mode: json
    body:json: {
      {
        "email":"prawirdani@gmail.xcom",
        "password": "12345678"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:30:22 GMT
      content-length: 110
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "check your credentials",
            "details": null,
            "code": "AUTH_CREDENTIALS"
          }
        }
      '''
    }
  }
}

example {
  name: Validation Errors
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/login
    method: POST
    mode: json
    body:json: {
      {
                
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:31:00 GMT
      content-length: 144
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "the request contains invalid data",
            "details": {
              "email": [
                "this field is required"
              ],
              "password": [
                "this field is required"
              ]
            },
            "code": "VALIDATION"
          }
        }
      '''
    }
  }
}

example {
  name: Rate Limited

  request: {
    url: {{BASE_URL}}/{{authPath}}/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "prawirdani@gmail.com",
        "password": "12345678"
      }
    }
  }

  response: {
    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "too many request try again latter",
            "details": null,
            "code": "REQ_RATE_LIMIT"
          }
        }
      '''
    }
  }
}
