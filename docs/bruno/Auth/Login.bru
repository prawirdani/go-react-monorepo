meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/{{authPath}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

example {
  name: Success
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/login
    method: POST
    mode: json
    body:json: {
      {
        "email":"prawirdani@gmail.com",
        "password": "12345678"
      }
    }
  }
  
  response: {
    headers: {
      cache-control: private, must-revalidate
