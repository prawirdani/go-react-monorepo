}

example {
  name: Expired Access Token

  request: {
    url: {{BASE_URL}}/{{authPath}}/me
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "access token expired",
            "details": null,
            "code": "AUTH_EXPIRED"
          }
        }
      '''
    }
  }
}

example {
  name: Invalid Session

  request: {
    url: {{BASE_URL}}/{{authPath}}/me
    method: GET
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
