example {
  name: Unauthenticated
  
  request: {
    url: {{BASE_URL}}/{{authPath}}/me
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      content-type: application/json
      vary: Origin, Accept-Encoding
      date: Thu, 23 Apr 2026 13:32:05 GMT
      content-length: 111
