example {
  name: Unauthenticated
  
  request: {
    url: {{BASE_URL}}/{{auditPath}}/?sort=created_at&order=DESC&page=1&limit=3&from=2026-09-17&to=2026-09-21&tz=Asia/Jakarta&entity=session,user,registration_token&actor={{userID}}
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "authentication required",
            "details": null,
            "code": "REQ_UNAUTHORIZED"
          }
        }
      '''
    }
  }
}

example {
  name: Forbidden
  
  request: {
    url: {{BASE_URL}}/{{auditPath}}/?sort=created_at&order=DESC&page=1&limit=3&from=2026-09-17&to=2026-09-21&tz=Asia/Jakarta&entity=session,user,registration_token&actor={{userID}}
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "error": {
            "message": "unauthorized action",
            "details": null,
            "code": "RBAC_UNAUTHORIZED_PERM"
          }
        }
      '''
    }
  }
}
