# Port `pnpm dev` serves the dashboard on.
VITE_PORT=3001

# Dev-only. Vite forwards `/api/*` here, so the browser stays same-origin and
# there is no CORS to configure. Unset means no proxy is registered.
VITE_PROXY_TARGET=http://localhost:8080

# API base URL the client calls.
#
# Empty — leave this empty when the API is deployed on the same domain as the
# dashboard. The client then calls `/api/*` relative to the page origin, which
# in dev hits VITE_PROXY_TARGET and in production is reverse-proxied by your web
# server (nginx, Caddy, the platform's routing). Same-origin means no absolute
# URL in the bundle, no CORS to configure, and nothing to rebuild when the
# domain changes.
#
# Set — when the API lives on a different domain from the dashboard, or the
# dashboard is a static host that cannot reverse-proxy `/api`. Use the API's
# absolute origin, e.g. `https://api.example.com`. VITE_PROXY_TARGET is then
# unused: the client talks to that origin directly and the API must allow the
# dashboard's origin through CORS.
VITE_API_URL=

# Asset server base URL for uploaded files (`/profiles/...`).
VITE_IMAGE_URL=https://your-assets-server.com

# Shown in the sidebar footer.
VITE_VERSION=v0.1.0
