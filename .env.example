# ===========================================================================
# go-react-monorepo: root env (backend, infra and client build)
# Copy to .env. NEVER commit .env. Only .env.example is committed.
# ===========================================================================

# ---- App ------------------------------------------------------------------
APP_NAME=go-restapi
APP_VERSION=0.1.0
APP_PORT=8080
APP_ENV=dev
# true -> account registration endpoint is not public
APP_INTERNAL_MODE=false

# ---- Network / proxy ------------------------------------------------------
# Comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4000,http://localhost:3000
CORS_CREDENTIALS=true
# Honour X-Forwarded-For for audit-log client IPs. Set true ONLY when a reverse
# proxy fronts the API (compose.caddy.yml sets it for you; set TRUST_PROXY=true
# for compose.yml behind a host proxy). Keep false for a directly-reachable API:
# with no proxy in front, a trusted header lets any caller forge its own IP, and
# the socket peer is used instead (a real IP that sessions.ip_addr, INET NOT
# NULL, accepts). The proxy itself is trusted by peer class (private / loopback
# / unix socket), not an address list, so there is nothing else to configure.
TRUST_PROXY=false

# ---- Database (SECRET: DB_PASSWORD) --------------------------------------
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost            # compose overrides to "postgres"
DB_PORT=5432
DB_NAME=go-react-monorepo
DB_MINCONNS=1
DB_MAXCONNS=12
# Optional worker pool size. Unset shares DB_MAXCONNS with the API.
DB_WORKER_MAXCONNS=3
DB_MAXCONN_LIFETIME=60m

# ---- Redis (SECRET: REDIS_PASSWORD) --------------------------------------
REDIS_HOST=localhost         # compose overrides to "redis"
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth (SECRET: AUTH_JWT_SECRET) ---------------------------------------
# Generate: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-to-a-random-string-at-least-33-chars
# Short TTL bounds revocation exposure while revocation checks fail open.
AUTH_JWT_TTL=15m
# true -> deny access when the revocation store errors (false fails open)
AUTH_REVOCATION_FAIL_CLOSED=false
AUTH_SESSION_TTL=168h        # 7 days
AUTH_PASSWORD_RECOVERY_TOKEN_TTL=15m
AUTH_EMAIL_CHANGE_TOKEN_TTL=15m
AUTH_REGISTRATION_TOKEN_TTL=15m
# Per-account brute-force lockout: failures allowed before lockout, and how
# long the lockout (and its failure window) lasts.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_TTL=15m
# Web UI pages that handle these flows
AUTH_RESET_PASSWORD_FORM_ENDPOINT=http://localhost:3000/auth/reset-password
AUTH_CONFIRM_EMAIL_CHANGE_FORM_ENDPOINT=http://localhost:3000/auth/confirm-email-change
AUTH_COMPLETE_REGISTRATION_FORM_ENDPOINT=http://localhost:3000/auth/register/complete

# ---- SMTP (SECRET: SMTP_AUTH_PASSWORD) -----------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SENDER_NAME=Example <example@mail.com>
SMTP_AUTH_EMAIL=example@mail.com
SMTP_AUTH_PASSWORD=

# ---- Cloudflare R2 uploads (SECRET: R2_ACCESS_KEY_*) ---------------------
# Public base URL of the bucket. Leave empty for a private bucket.
R2_BUCKET_URL=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=

# ---- Backups (SECRET: BACKUP_R2_*) ---------------------------------------
# Offsite-only: nightly `pg_dump -Fc` streamed to a SEPARATE, PRIVATE R2 bucket.
# There is no local copy. Retention is an R2 lifecycle rule on BACKUP_PREFIX,
# set in the Cloudflare dashboard — the sidecar never prunes.
#
# BACKUP_R2_BUCKET must never be R2_BUCKET (that bucket is public; the script
# hard-refuses to upload there). All four BACKUP_R2_* values are required for
# the sidecar to run.
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_ACCOUNT_ID=
BACKUP_PREFIX=postgres

# ---- Metrics --------------------------------------------------------------
# Empty -> follows APP_ENV on bare-metal; compose defaults it to true.
METRICS_ENABLED=
# Empty -> APP_PORT+1. Compose pins 9091.
METRICS_PORT=

# ---- Compose / deployment -------------------------------------------------
# ":80" (or empty) serves plain HTTP. Set a domain for automatic HTTPS, and
# then also set CADDY_HTTP_PORT=80 and CADDY_HTTPS_PORT=443, or ACME fails
# silently while HTTP keeps serving.
SITE_ADDRESS=
# Host ports for Caddy. Use 80/443 in production.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# Caddyfile (direct TLS) or Caddyfile.cloudflare (run update-cloudflare-ips.sh first)
CADDYFILE=Caddyfile

# Grafana binds to loopback, so reach it over an SSH tunnel.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ===========================================================================
# CLIENT (Vite). Everything below is PUBLIC.
# Only VITE_* reaches the browser bundle, so never put a secret under VITE_.
# ===========================================================================

# -- Dev server only (read in vite.config.ts, not used at runtime) -----------
VITE_PORT=3001
VITE_PROXY_TARGET=http://localhost:8080
VITE_ANALYZER=false

# -- Build-time, inlined into the bundle (baked when the caddy image builds) -
# Empty = same origin (Caddy serves dashboard and API), client calls /api.
# Set an absolute origin only if the API lives on another domain.
VITE_API_URL=
# Public base for uploaded files. Empty -> compose falls back to R2_BUCKET_URL.
VITE_IMAGE_URL=
VITE_VERSION=0.1.0
