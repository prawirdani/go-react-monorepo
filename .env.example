APP_NAME=go-restapi
APP_VERSION=0.1.0
APP_PORT=8080
APP_ENV=dev
# TRUE -> Account registration endpoint is not public.
APP_INTERNAL_MODE=false

DB_USER=postgres
DB_PASSWORD=pgdocker1337
DB_HOST=localhost
DB_PORT=5432
DB_NAME=golang-restapi
DB_MINCONNS=1
DB_MAXCONNS=12
# Worker pool size (optional). Unset shares DB_MAXCONNS with the API.
DB_WORKER_MAXCONNS=3
# 60 Minutes
DB_MAXCONN_LIFETIME=60m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Comma separated list of origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4000,http://localhost:3000
CORS_CREDENTIALS=true

# Comma separated list of CIDRs or IPs of trusted reverse proxies.
# Their X-Forwarded-For / X-Real-IP headers are honored to resolve the real
# client IP for audit logs. Leave empty if not behind a proxy.
# Compose overrides this to the project's own subnet (APP_NET_SUBNET), because
# Caddy is the proxy there and it is the only hop that should be trusted —
# NOT Docker's whole default address pool.
TRUSTED_PROXIES=127.0.0.1

AUTH_JWT_SECRET=change-me-to-a-random-string-at-least-33-chars
# Short access-token TTL bounds revocation exposure since revocation checks fail open.
AUTH_JWT_TTL=15m
# Deny access when the revocation store errors; false fails open.
AUTH_REVOCATION_FAIL_CLOSED=false
# 7 Days
AUTH_SESSION_TTL=168h
AUTH_PASSWORD_RECOVERY_TOKEN_TTL=15m
# Web UI that handle the reset password form
AUTH_RESET_PASSWORD_FORM_ENDPOINT=http://localhost:3000/auth/reset-password
AUTH_COMPLETE_REGISTRATION_FORM_ENDPOINT=http://localhost:3000/auth/register/complete
AUTH_REGISTRATION_TOKEN_TTL=15m

SMTP_HOST=smtp.example.com
SMTP_PORT=666
SMTP_SENDER_NAME=Example <example@mail.com>
SMTP_AUTH_EMAIL=example@mail.com
SMTP_AUTH_PASSWORD=<your-email-password>

# leave empty for private bucket
R2_BUCKET_URL=https://cdn.example.com 
R2_BUCKET=<YOUR_BUCKET>
R2_ACCOUNT_ID=<ACCOUNT_ID>
R2_ACCESS_KEY_ID=<ACCESS_KEY_ID>
R2_ACCESS_KEY_SECRET=<ACCESS_KEY_SECRET>

# --- Backups -------------------------------------------------------------
# Local retention, in files kept per tier. Same-host dumps are NOT offsite.
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
# Offsite target: a SEPARATE, PRIVATE R2 bucket. Never R2_BUCKET (it is public).
# Leave BACKUP_R2_BUCKET empty to keep backups local-only.
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Optional; defaults to R2_ACCOUNT_ID.
BACKUP_R2_ACCOUNT_ID=
BACKUP_PREFIX=postgres
BACKUP_R2_RETAIN_DAYS=30

# ===========================================================================
# Compose / deployment
# ===========================================================================

# Serve the Prometheus /metrics sidecar (defaults to true in production).
METRICS_ENABLED=
# Port the /metrics sidecar listens on. Unset -> APP_PORT+1. Compose pins 9091
# so the scrape target never moves when APP_PORT changes.
METRICS_PORT=

# Caddy site address. ":80" (default) serves plain HTTP on the mapped host port.
# Set a domain (e.g. api.example.com) to enable automatic HTTPS — and then set
# CADDY_HTTP_PORT=80 / CADDY_HTTPS_PORT=443, or ACME cannot validate the domain
# and issuance fails silently while HTTP keeps serving.
SITE_ADDRESS=

# Host ports mapped to the Caddy container's 80 and 443. Use 80/443 in
# production; 8080/8443 keeps the local stack off privileged ports.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Which Caddyfile to mount: Caddyfile (direct TLS) or Caddyfile.cloudflare
# (Cloudflare in front — run ./deployment/caddy/update-cloudflare-ips.sh first).
CADDYFILE=Caddyfile

# Subnet for the compose bridge network. Pinned so `api` can name a
# deterministic trusted-proxy CIDR (only Caddy may be trusted) instead of the
# whole Docker address pool.
APP_NET_SUBNET=172.28.0.0/24

# Grafana is bound to loopback (127.0.0.1) — reach it over an SSH tunnel. Docker
# port publishing bypasses ufw, so loopback binding is what keeps it private.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
