# busybox crond crontab (baked at /etc/crontabs/root). Unlike Debian/vixie cron:
# no user field, and SHELL=/PATH= assignment lines are ignored — so PATH is
# inlined in the job (pg_dump is in /usr/bin, rclone in /usr/local/bin).
#
# Twice daily, 03:15 and 15:15 (container TZ) — a 12h RPO. Sources the env
# snapshot the entrypoint wrote, then streams the dump to R2. Output goes to
# PID 1's stdout so `docker logs` shows it.
15 3,15 * * * PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; set -a; . /etc/backup.env; set +a; /usr/local/bin/backup-postgres.sh >> /proc/1/fd/1 2>&1
