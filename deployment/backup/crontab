# min hour dom mon dow  command
# Debian cron discards job output (and there is no syslog in this container), so
# redirect to PID 1's stdout to make the run (and any failure) visible in
# `docker logs backup`. Cron does not inherit the container environment, so the
# job sources the env file the image entrypoint writes at container start.
15 3 * * * root sh -c '. /run/backup.env; exec sh /backup-postgres.sh' > /proc/1/fd/1 2>&1
